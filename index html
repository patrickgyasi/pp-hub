<script>
const searchBox = document.getElementById("product-search");
const productGrid = document.getElementById("products");
const productCards = document.querySelectorAll("#products .product");
const categoryGrid = document.querySelector(".category-grid");
const categoryCards = document.querySelectorAll(".category-grid .category-card");
const noResults = document.getElementById("no-results");
const resultCount = document.getElementById("result-count");
const clearButton = document.getElementById("clear-search");
const navLinks = document.querySelectorAll(".site-nav .nav-link");

let activeCategory = "all";


function filterCatalogue() {
    const searchText = searchBox.value.trim().toLowerCase();
    let visibleCount = 0;

    productCards.forEach(function(card) {
        const categoryMatches =
            activeCategory === "all" ||
            card.dataset.category === activeCategory;

        const textMatches =
            card.textContent.toLowerCase().includes(searchText);

        const show = categoryMatches && textMatches;
        card.style.display = show ? "flex" : "none";

        if (show) visibleCount++;
    });

    categoryCards.forEach(function(card) {
        const categoryMatches =
            activeCategory === "all" ||
            card.dataset.category === activeCategory;

        const textMatches =
            card.textContent.toLowerCase().includes(searchText);

        const show = categoryMatches && textMatches;
        card.style.display = show ? "flex" : "none";

        if (show) visibleCount++;
    });

    const productsVisible = Array.from(productCards).some(
        card => card.style.display !== "none"
    );

    const categoriesVisible = Array.from(categoryCards).some(
        card => card.style.display !== "none"
    );

    productGrid.style.display = productsVisible ? "" : "none";
    categoryGrid.style.display = categoriesVisible ? "" : "none";

    noResults.style.display =
        visibleCount === 0 ? "block" : "none";

    resultCount.textContent =
        visibleCount === 0
            ? "No matching products or categories found"
            : "Showing " + visibleCount +
              (visibleCount === 1 ? " result" : " results");

    clearButton.style.display =
        searchText ? "inline-block" : "none";
}

// Navigation
navLinks.forEach(function(link) {
    link.addEventListener("click", function(event) {
        const target = link.getAttribute("href");

        const categories = {
            "#products": "all",
            "#phone-accessories": "phone-accessories",
            "#electronics": "electronics",
            "#home-appliances": "home-appliances",
            "#kitchen-accessories": "kitchen-accessories"
        };

        if (!(target in categories)) return;

        event.preventDefault();
        activeCategory = categories[target];

        navLinks.forEach(function(item) {
            item.classList.toggle("active", item === link);
        });

        filterCatalogue();
        history.replaceState(null, "", target);

        if (activeCategory === "all" ||
            activeCategory === "phone-accessories") {
            productGrid.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        } else {
            const selectedCard = document.getElementById(
                activeCategory
            );

            if (selectedCard) {
                selectedCard.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }
        }
    });
});

// Search updates immediately as the user types
searchBox.addEventListener("input", filterCatalogue);

// Clear the search while keeping the selected category
clearButton.addEventListener("click", function() {
    searchBox.value = "";
    filterCatalogue();
    searchBox.focus();
});

// Initial display
filterCatalogue();

/* PP Hub: Local affiliate click tracking */
const affiliateLinks = document.querySelectorAll(
    'a[href*="jmia.io"]'
);

affiliateLinks.forEach(function(link) {
    link.addEventListener("click", function() {
        const category =
            link.closest(".category-card")
                ?.dataset.category || "other";

        const storageKey = "ppHubClicks";
        let clicks = {};

        try {
            clicks = JSON.parse(
                localStorage.getItem(storageKey) || "{}"
            );
        } catch (error) {
            clicks = {};
        }

        clicks[category] = (clicks[category] || 0) + 1;

        try {
            localStorage.setItem(
                storageKey,
                JSON.stringify(clicks)
            );
        } catch (error) {
            console.log("Click count could not be saved.");
        }

        console.log(
            "PP Hub affiliate click:",
            category,
            "Total:",
            clicks[category]
        );
    });
});

</script>

